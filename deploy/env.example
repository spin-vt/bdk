# BDK production configuration template. Copy to web/.env and data/.env on
# the respective hosts, fill in real values, chmod 600. Never commit a
# filled-in copy. Rotate by editing the file and `docker compose up -d`.

# --- database (both hosts; the data host runs it, the web host dials in) ---
POSTGRES_USER=bdk
POSTGRES_PASSWORD=__GENERATE_32_RANDOM_CHARS__
POSTGRES_DB=bdk
DB_HOST=__DATA_HOST_IP__        # on the data host: db (the compose service)
DB_PORT=5432

# --- redis / celery (both hosts) -------------------------------------------
REDIS_PASSWORD=__GENERATE_32_RANDOM_CHARS__
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@__DATA_HOST_IP__:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@__DATA_HOST_IP__:6379/0

# --- app secrets (web + data hosts; JWT must match everywhere) --------------
SECRET_KEY=__GENERATE_32_RANDOM_CHARS__
JWT_SECRET=__GENERATE_AT_LEAST_32_RANDOM_CHARS__
JWT_TOKEN_LOCATION=cookies
JWT_ACCESS_COOKIE_NAME=token
IN_PRODUCTION=1

# --- web host only -----------------------------------------------------------
SERVER_NAME=__PUBLIC_HOSTNAME__
PUBLIC_BASE_URL=https://__PUBLIC_HOSTNAME__
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
SSL_CERT_PATH=__/path/to/cert.crt__
SSL_KEY_PATH=__/path/to/private_key.pem__
DEVELOP_BACKEND_PORT=8000
MAPTILE_STREET=https://api.maptiler.com/maps/streets/style.json?key=__MAPTILER_KEY__

# --- mail (web + data hosts; workers send too) -------------------------------
MAIL_SERVER=__SMTP_HOST__
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=__SMTP_USER__
MAIL_PASSWORD=__SMTP_PASSWORD__
MAIL_DEFAULT_SENDER=__FROM_ADDRESS__

# --- data host resource caps (tune to the box) -------------------------------
DB_CPUS=24
DB_MEM_LIMIT=32g
WORKER_CPUS=16
WORKER_MEM_LIMIT=24g
