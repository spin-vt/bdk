# Copy to .env and fill in. Consumed by docker-compose and the Flask/Celery app.
#   cp .env.example .env   &&   make up

# --- Database (Postgres) ---
POSTGRES_USER=bdk
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bdk
POSTGRES_HOST_AUTH_METHOD=trust
DB_HOST=db            # "db" for docker-compose (Docker DNS); "localhost" for host networking (prod)
DB_PORT=5432

# --- Auth (Flask / JWT) ---
SECRET_KEY=dev-secret-change-me
JWT_SECRET=dev-jwt-secret-change-me
JWT_TOKEN_LOCATION=cookies
JWT_ACCESS_COOKIE_NAME=token

# --- Email (Flask-Mail) ---
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@example.com

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Frontend (NEXT_PUBLIC_* vars are baked into browser-side code) ---
# API base URL the frontend calls. In local dev, requests go through nginx on
# localhost, so the default below is what you want.
NEXT_PUBLIC_DEVELOP_BACKEND_URL=http://localhost
# MapTiler style URLs for the basemap layers (need a free MapTiler API key,
# e.g. https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY).
# Optional: the app boots without them; the basemap is just blank.
NEXT_PUBLIC_DEVELOP_MAPTILE_STREET=
NEXT_PUBLIC_DEVELOP_MAPTILE_SATELITE=
NEXT_PUBLIC_DEVELOP_MAPTILE_DARK=

# --- Ports ---
DEVELOP_BACKEND_PORT=8000
DEVELOP_FRONTEND_PORT=3000
NGINX_HTTP_PORT=80

# --- pgAdmin ---
POSTGRES_ADMIN_EMAIL=admin@example.com
POSTGRES_ADMIN_PASSWORD=admin

# --- Docker image names (used by the compose files; fine to leave as-is for local builds) ---
DOCKER_IMAGE_BACKEND=bdk-backend
DOCKER_IMAGE_FRONTEND=bdk-frontend
DOCKER_IMAGE_WORKER=bdk-worker
DOCKER_IMAGE_NGINX=bdk-nginx
