FROM python:3.12-slim-bookworm

# System deps: tippecanoe build toolchain, GDAL CLI (used by the signal-server
# raster path), image tooling, and libpq for psycopg2.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git build-essential g++ make cmake \
    libsqlite3-dev zlib1g-dev libbz2-dev \
    gdal-bin imagemagick zip libpq5 ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# uv (Python package/dependency manager)
RUN pip install --no-cache-dir uv

# Tippecanoe (vector tile generation) from source
RUN git clone --depth 1 https://github.com/mapbox/tippecanoe.git /tmp/tippecanoe \
  && make -C /tmp/tippecanoe -j"$(nproc)" \
  && make -C /tmp/tippecanoe install \
  && rm -rf /tmp/tippecanoe \
  && which tippecanoe

# Install Python deps into a venv OUTSIDE /app, so the dev compose bind-mount of
# ./back-end:/app does not hide it. Runtime deps only (no dev group).
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/opt/venv/bin:$PATH"
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

# Bake the application code into the image (as Dockerfile.worker does) so a
# backend:<sha> image is a self-contained artifact: production pulls it from
# the registry; code is never built or bind-mounted on the host. The dev
# compose still bind-mounts ./back-end over /app for live reload (the venv at
# /opt/venv is outside /app, so neither path hides it).
COPY . .

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Migrations run on startup; the actual server command comes from docker-compose
# (Flask dev server in dev; gunicorn in prod).
ENTRYPOINT ["/entrypoint.sh"]
